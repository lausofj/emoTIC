# ============================================================
# emoTIC Backend - Plantilla de Configuración de Entorno
# Copia este archivo como .env y ajusta los valores locales
# ============================================================

# Base de Datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=emotic_db
DB_USER=root
DB_PASS=

# Seguridad y Claves de API
# Llave requerida en la cabecera X-API-Key para envíos anónimos de intentos
APP_API_KEY=emotic_client_secret_key_2024

# Clave secreta para la firma de tokens de sesión de docentes (HMAC-SHA256)
AUTH_SECRET=reemplazar_con_secreto_aleatorio_para_produccion

# Tiempo de expiración de token de sesión en segundos (8 horas = 28800)
AUTH_TOKEN_TTL=28800
